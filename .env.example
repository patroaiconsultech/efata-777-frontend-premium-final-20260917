VITE_API_BASE_URL=http://localhost:8080
VITE_STREAM_TIMEOUT_MS=300000

# OIDC Authorization Code + PKCE (SPA; nunca use client secret no frontend)
VITE_OIDC_AUTHORIZATION_ENDPOINT=
VITE_OIDC_TOKEN_ENDPOINT=
VITE_OIDC_END_SESSION_ENDPOINT=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_AUDIENCE=

# Origens permitidas em connect-src, separadas por espaço.
# Inclua o backend e a origem do endpoint de token OIDC.
ORKIO_CSP_CONNECT_SRC=http://localhost:8080
