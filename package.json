{
  "name": "orkio-v2-premium-frontend",
  "version": "2.0.0-alpha.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "start": "node server.mjs",
    "test:pwa": "node --test tests/*.test.mjs",
    "check:server": "node --check server.mjs",
    "check:sw": "node --check public/sw.js",
    "check": "npm run check:server && npm run check:sw && npm run test && npm run verify:lock && npm run typecheck",
    "verify:lock": "node scripts/verify-lockfile.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build:evidence": "node scripts/build-evidence.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.14",
    "typescript": "5.7.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.2"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.20.2",
    "npm": "10.8.2"
  }
}
